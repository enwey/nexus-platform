<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#8E54FF"
                android:startColor="#4FB9FF" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <item
        android:bottom="18dp"
        android:left="28dp"
        android:right="28dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#66FFFFFF" />
        </shape>
    </item>

    <item
        android:bottom="14dp"
        android:drawable="@drawable/ic_launcher_gamepad"
        android:gravity="center"
        android:height="34dp"
        android:width="34dp" />
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 保持 1.5 倍縮放 -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="1.5"
        android:scaleY="1.5">

        <!-- 優化後的圓環：將半徑縮小到 7.3 -->
        <!-- 這樣 7.3 * 1.5 = 10.95，加上 0.6 的描邊邊緣，正好在 12 的邊界內 -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.2"
            android:pathData="M12,12m-7.3,0a7.3,7.3 0,1 1,14.6 0a7.3,7.3 0,1 1,-14.6 0" />

        <!-- 內部的 X：坐標也同步收縮，確保與圓環有呼吸感 -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.2"
            android:strokeLineCap="round"
            android:pathData="M9.2,9.2 L14.8,14.8 M14.8,9.2 L9.2,14.8" />

    </group>
</vector>